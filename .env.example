# Скопируйте в .env и при необходимости поменяйте значения.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# Добавьте публичный адрес, если сервер открыт наружу, например https://votes.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Админ создаётся автоматически при первом запуске (/admin).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_EMAIL=admin@example.com

POSTGRES_DB=votes
POSTGRES_USER=votes
POSTGRES_PASSWORD=votes

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=votes-media
# Адрес MinIO, видимый из браузера/телефона (для ссылок на аудио и картинки).
S3_PUBLIC_DOMAIN=localhost:9000/votes-media
